{
  "name": "@paper/back",
  "version": "0.1.0",
  "exports": "./mod.ts",
  "workspace": [
    "./lib"
  ],
  "tasks": {
    "dev": "ENV=development deno run -A --watch=src,lib,mod.ts,deps.ts --no-clear-screen mod.ts",
    "start": "deno run -A mod.ts",
    "check": "deno check mod.ts"
  },
  "fmt": {
    "files": {
      "exclude": [
        "declaration"
      ]
    },
    "options": {
      "useTabs": true,
      "lineWidth": 80,
      "indentWidth": 4,
      "semiColons": true,
      "proseWrap": "preserve"
    }
  },
  "imports": {
    "deps": "./deps.ts"
  },
  "nodeModulesDir": "auto"
}
