{
  "workspace": [
    "./back",
    "./lib"
  ],
  "tasks": {
    "bc-dev": "ENV=development deno run -A --watch --watch-exclude=declarations --no-clear-screen ./back/mod.ts"
  },
  "fmt": {
    "files": {
      "exclude": [
        "declaration"
      ]
    },
    "options": {
      "useTabs": true,
      "lineWidth": 80,
      "indentWidth": 4,
      "semiColons": true,
      "proseWrap": "preserve"
    }
  },
  "imports": {
    "deps": "./deps.ts"
  },
  "nodeModulesDir": "auto"
}